{
  "name": "deriva",
  "version": "2.0.1",
  "description": "Deriva desktop learning assistant",
  "main": "./out/main/index.js",
  "author": "deriva",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "compile:tiling-smoke": "esbuild scripts/external-tiling-app-smoke.ts --bundle --platform=node --external:electron --external:koffi --format=cjs --outfile=out/main/external-tiling-app-smoke.cjs",
    "smoke:tiling": "npm run build && npm run compile:tiling-smoke && electron out/main/external-tiling-app-smoke.cjs",
    "accept:tiling": "npm run build && npm run compile:tiling-smoke && node scripts/run-external-tiling-acceptance.cjs",
    "measure:tiling-block": "npm run build && esbuild scripts/external-tiling-blocking-smoke.ts --bundle --platform=node --external:electron --external:koffi --format=cjs --outfile=out/main/external-tiling-blocking-smoke.cjs && electron out/main/external-tiling-blocking-smoke.cjs",
    "smoke:tiling-packaged-worker": "esbuild scripts/packaged-tiling-worker-smoke.ts --bundle --platform=node --external:electron --external:koffi --format=cjs --outfile=out/main/packaged-tiling-worker-smoke.cjs && electron out/main/packaged-tiling-worker-smoke.cjs"
  },
  "dependencies": {
    "@koromix/koffi-win32-x64": "3.3.3",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@xyflow/react": "^12.12.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "katex": "^0.19.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.deriva.app",
    "productName": "Deriva",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/@koromix/koffi-win32-x64/**",
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
